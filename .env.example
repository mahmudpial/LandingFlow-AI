# LandingFlow AI — Root Environment Template
# Copy backend/.env.example to backend/.env and frontend/.env.example to frontend/.env

APP_NAME="LandingFlow AI"
APP_ENV=local
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# Database (SQLite by default for zero-cost local development; PostgreSQL for production)
DB_CONNECTION=sqlite
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=landingflow
# DB_USERNAME=landingflow
# DB_PASSWORD=secret

# AI Provider (mock | bedrock) — Keep mock by default to avoid AWS costs
AI_PROVIDER=mock
AI_RATE_LIMIT_PER_HOUR=15
AWS_DEFAULT_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
